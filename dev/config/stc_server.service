# Steering Turret Control (STC)
#
# This file is part of the STC development codebase.
#
# File purpose:
#   systemd unit for deploying stc_server from /opt/stc.
#
# Design notes:
#   Encodes real-time scheduling expectations via CAP_SYS_NICE and RT priority limits.
#   Assumes /opt/stc layout and explicit config path for deterministic startup behavior.
#   Restart policy is tuned for unattended service recovery after runtime faults.
#   Keep systemd directive syntax intact; comments-only edits must not alter semantics.

[Unit]
# systemd unit for persistent STC runtime startup after network is online.
Description=STC Server
After=network-online.target
Wants=network-online.target

[Service]
# Service runs from /opt/stc so relative logs/configs resolve consistently.
Type=simple
User=stc
Group=stc
WorkingDirectory=/opt/stc
ExecStart=/opt/stc/bin/stc_server --config /opt/stc/config/stc_default.ini --rt-enabled 1 --rt-strict 1 --rt-policy fifo
Restart=on-failure
RestartSec=2

# Required for real-time scheduling without running as root.
# CAP_SYS_NICE allows FIFO priority setup requested by --rt-* options.
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=80
LimitRTTIME=infinity
NoNewPrivileges=true

# Note: raw CAN access (PF_CAN/SOCK_RAW) may require additional deployment
# permissions/groups (for example, CAN device ACLs) outside this unit file.

[Install]
WantedBy=multi-user.target
